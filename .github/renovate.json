{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "rangeStrategy": "update-lockfile",
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "labels": ["dependencies"],
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Automerge non-major updates once all required status checks are green",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Major updates are listed in the Dependency Dashboard and only get a PR after approving them there",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Update the PHP platform constraint together with the PHP docker image",
      "matchManagers": ["composer", "dockerfile"],
      "matchDepNames": ["php"],
      "groupName": "PHP"
    },
    {
      "matchManagers": ["composer"],
      "addLabels": ["php"]
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "addLabels": ["docker"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions"]
    }
  ]
}

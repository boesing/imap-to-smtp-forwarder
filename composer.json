{
    "name": "boesing/imap-to-smtp-forwarder",
    "description": "Docker image to pull mails from an imap server, forward them to one or more mails and either move or delete those mails afterwards",
    "type": "project",
    "license": "BSD-3-Clause",
    "autoload": {
        "psr-4": {
            "Boesing\\ImapToSmtpForwarder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Boesing\\ImapToSmtpForwarder\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "~8.5.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-imap": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "cuyz/valinor": "^2.0",
        "laminas/laminas-diactoros": "^3.9",
        "php-imap/php-imap": "^5.1",
        "symfony/console": "^7.4.21",
        "symfony/mailer": "^7.4.19",
        "symfony/process": "^7.4.21",
        "zbateson/mail-mime-parser": "^3.0.9"
    },
    "require-dev": {
        "doctrine/coding-standard": "^12.0",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^13.0",
        "vimeo/psalm": "^6.0"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-intl-grapheme": "*",
        "symfony/polyfill-intl-idn": "*",
        "symfony/polyfill-intl-normalizer": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php84": "*"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "classmap-authoritative": true,
        "sort-packages": true
    },
    "scripts": {
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "analyze": "vendor/bin/psalm --stats",
        "test": "vendor/bin/phpunit",
        "test-integration": "vendor/bin/phpunit --testsuite integration"
    }
}
